<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AIVES</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/function2.css" />
</head>
<body>
    <header class="app-header"><nav class="nav-container">
        <a class="nav-brand" asp-controller="Home" asp-action="Index">AIVES Viva Exam</a>
        <div class="nav-links">
        @if (User.IsInRole("LECTURER"))
        {
            <a asp-controller="Exams" asp-action="Index">Dashboard / Exams</a>
            <a asp-controller="Courses" asp-action="Index">Môn học & câu hỏi</a>
            <a asp-controller="Exams" asp-action="Create">Tạo kỳ thi</a>
        }
        @if (User.IsInRole("STUDENT"))
        {
            <a asp-controller="Student" asp-action="MySchedule">My Schedule</a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Logout</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a asp-controller="Account" asp-action="Register">Register</a>
        }
        </div>
    </nav></header>
    <main class="main-content">
        @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="app-footer">AIVES · Viva Exam Management</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
