abelBackgroundColor=#ffffff;exitX=0;exitY=0.579250720461095;entryX=1;entryY=0.810880829015544;" edge="1" parent="1" source="gemini" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="http-note" value="HTTP / JSON&#xa;SignalR / WebSocket" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="395" y="555" width="148" height="55" as="geometry"/></mxCell><mxCell id="sql-note" value="SQL / TCP" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1132" y="369" width="128" height="25" as="geometry"/></mxCell><mxCell id="google-note" value="HTTPS / WSS" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1122" y="803" width="145" height="25" as="geometry"/></mxCell><mxCell id="footer" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="948" width="1610" height="112" as="geometry"/></mxCell><mxCell id="foot-title" value="QUY ƯỚC &amp; PHẠM VI" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="footer"><mxGeometry x="20" y="16" width="1570" height="24" as="geometry"/></mxCell><mxCell id="foot-text" value="Chỉ hai loại mũi tên: Request (xanh dương) và Response (xanh lá). SignalR Response bao gồm sự kiện server push / transcript.&#xa;Frontend chỉ kết nối backend; không truy cập trực tiếp MySQL hoặc Gemini. Các khối bên trong monolith cùng tiến trình, không phải microservices.&#xa;Sơ đồ thể hiện luồng đang nối vào ứng dụng; mã legacy / trang mô phỏng chưa được route không được xem là tích hợp đang hoạt động." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="footer"><mxGeometry x="20" y="47" width="1570" height="63" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>